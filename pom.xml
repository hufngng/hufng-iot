<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath />
  </parent>

  <groupId>com.hufng.iot</groupId>
  <artifactId>hufng-iot</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>hufng-iot</name>
  <description>IoT ingestion pipeline: device -> MQTT -> Kafka -> ClickHouse + rule engine -> alert</description>

  <modules>
    <module>hufng-common</module>
    <module>hufng-ingest</module>
    <module>hufng-report</module>
    <module>hufng-notification</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spring Cloud 2023.0.x ("Leyton") is the release train compatible with Spring Boot 3.3.x -->
    <spring-cloud.version>2023.0.3</spring-cloud.version>
    <clickhouse-jdbc.version>0.6.5</clickhouse-jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.hufng.iot</groupId>
        <artifactId>hufng-common</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Shared by hufng-ingest/hufng-report/hufng-notification (eureka client) -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- hufng-report: JDBC driver for ClickHouse (telemetry storage) -->
      <dependency>
        <groupId>com.clickhouse</groupId>
        <artifactId>clickhouse-jdbc</artifactId>
        <version>${clickhouse-jdbc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
